{
  "name": "astro-antfustyle-theme",
  "version": "2.3.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown --cache",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "toolbar:on": "astro preferences enable devToolbar",
    "toolbar:off": "astro preferences disable devToolbar",
    "prepare": "simple-git-hooks",
    "postbuild": "pagefind --site dist --exclude-selectors \"pre\" --include-characters \"<>\" && del-cli \"dist/pagefind/*ui*\""
  },
  "devDependencies": {
    "@ascorbic/feed-loader": "^2.0.1",
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/svelte": "^9.1.6",
    "@atproto/api": "^0.32.0",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@iconify/json": "^2.2.556",
    "@myriaddreamin/typst-ts-node-compiler": "0.6.1-rc3",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@types/p5": "^1.7.7",
    "@typescript-eslint/parser": "^8.72.2",
    "@unocss/astro": "66.13.0",
    "@unocss/reset": "66.13.0",
    "astro": "^7.4.12",
    "astro-expressive-code": "^0.44.3",
    "astro-loader-bluesky-posts": "^1.2.5",
    "astro-loader-github-prs": "^2.0.1",
    "astro-loader-github-releases": "^3.0.1",
    "astro-robots-txt": "^1.0.0",
    "astro-typst": "^0.12.4",
    "chalk": "^6.0.1",
    "del-cli": "^8.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "html-entities": "^2.6.0",
    "lint-staged": "^17.6.0",
    "mdast-util-to-string": "^4.0.0",
    "nprogress": "^0.2.0",
    "p5": "^1.11.13",
    "pagefind": "^1.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-wrap-all": "^1.1.0",
    "remark-directive": "^4.0.0",
    "remark-directive-sugar": "^2.0.1",
    "remark-imgattr": "^1.1.1",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unist-util-visit": "^5.2.0",
    "unocss": "66.13.0",
    "viewerjs": "^1.15.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint"
    ]
  },
  "engines": {
    "node": "18.20.8 || ^20.9.0 || ^22.0.0"
  }
}
